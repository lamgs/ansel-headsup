# --- Slack (from your app's settings page) ---
SLACK_BOT_TOKEN=xoxb-...          # OAuth & Permissions → Bot User OAuth Token
SLACK_APP_TOKEN=xapp-...          # Basic Information → App-Level Tokens (scope: connections:write)

# --- Who gets cards ---
# Map demo personas to Slack users. IDs (U...) or emails both work.
SLACK_USERS=maya=you@example.com
# Persona used by `/headsup demo` when none is given
DEMO_PERSONA=maya

# --- Calendar (optional; manual trigger works without it) ---
# Google Calendar: Settings → your calendar → "Secret address in iCal format"
# Outlook: Settings → Calendar → Shared calendars → Publish a calendar → ICS link
CALENDAR_ICS_URL=
# Calendar title → seeded Ansel series. Default matches the series titles.
SERIES_MAP=Weekly Product Sync=wps,Design Review=dr
REMINDER_MINUTES=30
POLL_SECONDS=60

# --- Links ---
# Where the prototype is hosted (npm run build in the repo root, host dist/). Enables ▶ deep links.
PROTOTYPE_URL=
# Used when the calendar event has no Meet/Teams/Zoom link, and for manual demos
DEMO_JOIN_URL=https://meet.google.com/
