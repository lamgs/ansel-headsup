# --- Slack (from your app's settings page) ---
SLACK_BOT_TOKEN=xoxb-...          # OAuth & Permissions → Bot User OAuth Token
SLACK_APP_TOKEN=xapp-...          # Basic Information → App-Level Tokens (scope: connections:write)

# --- Who gets cards ---
# Deny-by-default allowlist for every command, DM, and button action.
# Add Slack user IDs (U...) or emails, separated by commas.
ALLOWED_SLACK_USERS=you@example.com
# Map demo personas to Slack users. IDs (U...) or emails both work.
SLACK_USERS=gabriel=you@example.com
# Persona used by `/headsup demo` when none is given
DEMO_PERSONA=gabriel

# --- Calendar (optional; manual trigger works without it) ---
# Google Calendar: Settings → your calendar → "Secret address in iCal format"
# Outlook: Settings → Calendar → Shared calendars → Publish a calendar → ICS link
# Per-person calendars (recommended): one variable per persona in SLACK_USERS.
# Each feed only triggers cards for its owner. Each link is a secret: anyone with it can read that calendar.
CALENDAR_ICS_URL_GABRIEL=
# CALENDAR_ICS_URL_ALICIA=
# Shared fallback for any mapped persona without its own CALENDAR_ICS_URL_<PERSONA>.
CALENDAR_ICS_URL=
# Calendar title → seeded Ansel series. Default matches the series titles.
SERIES_MAP=Weekly Product Sync=wps,Design Review=dr
REMINDER_MINUTES=30
POLL_SECONDS=60

# --- Links ---
# Where the card's ▶ links open. Defaults to the GitHub Pages prototype (https://lamgs.github.io/ansel-headsup/);
# set another URL to override, or `off` to reply in Slack instead of linking.
# PROTOTYPE_URL=
# Used when the calendar event has no Meet/Teams/Zoom link, and for manual demos
DEMO_JOIN_URL=https://zoom.us/

# --- Ansel → Slack status sync (optional) ---
# Lets Mark done / On track / New date / Reassign in the hosted Ansel prototype update the Slack card.
# Card links then carry a signed key (?k=…) for that card's persona. Generate once: openssl rand -hex 32
# SYNC_SECRET=
# Public HTTPS name for the API, used by deploy/setup-vm.sh to set up Caddy. "auto" = <external-ip>.sslip.io
# PUBLIC_HOSTNAME=auto
# Local port the API listens on (Caddy forwards /api/* to it). Railway sets PORT instead.
# API_PORT=8787
# Browser origins allowed to call the API (default: https://lamgs.github.io and local Vite servers)
# API_ALLOWED_ORIGINS=https://lamgs.github.io
# Where state is saved (item statuses, mutes, live cards). The VM's systemd unit sets this automatically.
# STATE_FILE=./state.json
